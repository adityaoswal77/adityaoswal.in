# Copy to .env.local and fill in. .env.local is gitignored. Restart `npm run dev` after editing it.

# Adi.Os chatbot (app/api/chat/route.ts). Providers are tried in order (Cloudflare, then NVIDIA);
# a provider with missing vars is skipped, and if all fail the chat shows a LinkedIn fallback.
# Add the vars to every Vercel environment you want chat in (Production, Preview, Development).

# Primary: Cloudflare Workers AI (free 10,000 neurons/day, resets 00:00 UTC).
# Account ID: Cloudflare dashboard > Workers AI (right sidebar). Token: dash.cloudflare.com/profile/api-tokens
# > Create Token > "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional model override (default @cf/meta/llama-3.1-8b-instruct; 70B @cf/meta/llama-3.3-70b-instruct-fp8-fast is always the next fallback).
CLOUDFLARE_CHAT_MODEL=

# Backup: NVIDIA. Create a key at https://build.nvidia.com (free tier).
NVIDIA_API_KEY=
# Optional model override. NVIDIA retires hosted models, so check the live list first:
# curl https://integrate.api.nvidia.com/v1/models
# Defaults to nv-mistralai/mistral-nemo-12b-instruct when empty.
NVIDIA_CHAT_MODEL=

# Optional: logs chat questions to Vercel Blob. Failures are swallowed, so chat works without it.
BLOB_READ_WRITE_TOKEN=
