# Copy to .env.local and fill in. .env.local is gitignored. Restart `npm run dev` after editing it.

# Adi.Os chatbot (app/api/chat/route.ts). Create a key at https://build.nvidia.com (free tier).
# Production only in Vercel today; add it to the Preview environment too to test chat on staging.
NVIDIA_API_KEY=

# Optional: override the chat model without a code change. NVIDIA retires hosted models, so check
# the live list first: curl https://integrate.api.nvidia.com/v1/models
# Defaults to nv-mistralai/mistral-nemo-12b-instruct when empty.
NVIDIA_CHAT_MODEL=

# Optional: logs chat questions to Vercel Blob. Failures are swallowed, so chat works without it.
BLOB_READ_WRITE_TOKEN=
